# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Configured for high-fidelity vocal synthesis (British JARVIS voice)
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# GOOGLE_SEARCH_API_KEY: Configured for live web search grounding
GOOGLE_SEARCH_API_KEY="MY_GOOGLE_SEARCH_API_KEY"

# OPENAI_API_KEY: Configured for OpenAI GPT models and Whisper speech-to-text fallback
OPENAI_API_KEY="MY_OPENAI_API_KEY"
